{
  "name": "yazio-mcp",
  "version": "0.0.16",
  "description": "MCP server for accessing Yazio user & nutrition data (unofficial)",
  "mcpName": "io.github.fliptheweb/yazio-mcp",
  "author": "fliptheweb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fliptheweb/yazio-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/fliptheweb/yazio-mcp/issues"
  },
  "homepage": "https://github.com/fliptheweb/yazio-mcp#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "yazio-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --format=esm --packages=bundle --outfile=dist/index.js",
    "pack:mcpb": "node scripts/pack-mcpb.cjs",
    "build:mcpb": "npm run build && npm run pack:mcpb",
    "build:mcpb:unpacked": "npm run build && node scripts/pack-mcpb.cjs --unpacked",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "release:prepare": "npm version --no-git-tag-version",
    "version": "node scripts/bump-version.cjs && git add manifest.json server.json"
  },
  "keywords": [
    "mcp",
    "yazio",
    "nutrition",
    "diet",
    "model-context-protocol",
    "health",
    "fitness"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.6.2",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "uuid": "^14.0.3",
    "zod": "^4.2.1"
  }
}
